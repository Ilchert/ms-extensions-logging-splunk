<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <!-- Benchmark the working tree by default, or a prebuilt library with /p:SplunkLibraryDll=<path>. -->
  <ItemGroup Condition="'$(SplunkLibraryDll)' == ''">
    <ProjectReference Include="..\..\src\Splunk.Extensions.Logging\Splunk.Extensions.Logging.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(SplunkLibraryDll)' != ''">
    <Reference Include="Splunk.Extensions.Logging">
      <HintPath>$(SplunkLibraryDll)</HintPath>
    </Reference>
  </ItemGroup>

</Project>
