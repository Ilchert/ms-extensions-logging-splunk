<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- NuGet metadata -->
		<PackageId>Splunk.Extensions.Logging</PackageId>
		<Version>0.1.0</Version>
		<Description>A Microsoft.Extensions.Logging provider that sends logs to Splunk.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageProjectUrl>https://github.com/Ilchert/ms-extensions-logging-splunk</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Ilchert/ms-extensions-logging-splunk</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>splunk;logging;microsoft-extensions-logging</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Options" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Splunk.Extensions.Logging.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
